# Config fragment for scanning the AEAD userspace-crypto API.
#
# Enables the kernel's userspace AF_ALG AEAD interface (the code path
# that hosts CVE-2026-31431 "Copy Fail") and the crypto plumbing it
# depends on.  Networking is required because AF_ALG rides on a
# socket.
#
# Use together with baseline.config via scan/configure.sh.
CONFIG_NET=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_ALGAPI=y
CONFIG_CRYPTO_ALGAPI2=y
CONFIG_CRYPTO_AEAD=y
CONFIG_CRYPTO_AEAD2=y
CONFIG_CRYPTO_USER=y
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_AEAD=y
