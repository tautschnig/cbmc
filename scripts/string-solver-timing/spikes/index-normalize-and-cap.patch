@@ -3061,6 +3066,33 @@ static void get_sub_arrays(
 /// \param ns: namespace
 /// \param s: an expression containing strings
 /// \param i: an expression representing an index
+/// \p e with max(0, l) (zero_if_negative) replaced by l where l is a length
+/// symbol of the array pool: lengths are non-negative, so that both forms of
+/// a position made distinct index terms (and twice the instantiations).
+static exprt without_max_of_lengths(const exprt &e)
+{
+  if(const auto if_expr = expr_try_dynamic_cast<if_exprt>(e))
+  {
+    const exprt &cond = if_expr->cond();
+    if(
+      cond.id() == ID_ge && to_binary_expr(cond).lhs() == if_expr->true_case() &&
+      to_binary_expr(cond).rhs().is_zero() && if_expr->false_case().is_zero() &&
+      if_expr->true_case().id() == ID_symbol &&
+      has_prefix(
+        id2string(to_symbol_expr(if_expr->true_case()).get_identifier()),
+        "string_refinement#string_length#"))
+    {
+      return if_expr->true_case();
+    }
+  }
+  if(!e.has_operands())
+    return e;
+  exprt result = e;
+  for(auto &op : result.operands())
+    op = without_max_of_lengths(op);
+  return result;
+}
