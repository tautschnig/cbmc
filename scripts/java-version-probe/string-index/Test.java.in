// The exceptions of String's index methods in each Java version, as
// measured on JDK 8 to 25 (generated by
// scripts/java-version-probe/string-index/gen_test.py; NullPointerException
// messages, which may be the helpful ones of the JVM, are not compared).
public class Test {
  static String fail(RuntimeException e) {
    if (e instanceof StringIndexOutOfBoundsException) {
      return "StringIndexOutOfBoundsException: " + e.getMessage();
    }
    if (e instanceof ArrayIndexOutOfBoundsException) {
      return "ArrayIndexOutOfBoundsException: " + e.getMessage();
    }
    if (e instanceof IndexOutOfBoundsException) {
      return "IndexOutOfBoundsException: " + e.getMessage();
    }
    return "other";
  }
  static String charAt(String s, int i) {
    try {
      return "" + (int) s.charAt(i);
    } catch (RuntimeException e) {
      return fail(e);
    }
  }
  static String codePointAt(String s, int i) {
    try {
      return "" + s.codePointAt(i);
    } catch (RuntimeException e) {
      return fail(e);
    }
  }
  static String codePointBefore(String s, int i) {
    try {
      return "" + s.codePointBefore(i);
    } catch (RuntimeException e) {
      return fail(e);
    }
  }
  static String substring1(String s, int i) {
    try {
      return s.substring(i);
    } catch (RuntimeException e) {
      return fail(e);
    }
  }
  static String substring(String s, int b, int e) {
    try {
      return s.substring(b, e);
    } catch (RuntimeException x) {
      return fail(x);
    }
  }
  static String codePointCount(String s, int b, int e) {
    try {
      return "" + s.codePointCount(b, e);
    } catch (RuntimeException x) {
      return fail(x);
    }
  }
  static String getChars(String s, int b, int e, int d) {
    char[] dst = new char[3];
    try {
      s.getChars(b, e, dst, d);
      return new String(dst);
    } catch (RuntimeException x) {
      return fail(x);
    }
  }
  static String getBytes(String s, int b, int e, int d) {
    byte[] dst = new byte[3];
    try {
      s.getBytes(b, e, dst, d);
      return "[" + dst[0] + ", " + dst[1] + ", " + dst[2] + "]";
    } catch (RuntimeException x) {
      return fail(x);
    }
  }
  static String contentEqualsSb(String s) {
    return "" + s.contentEquals(new StringBuilder(s));
  }
  static String regionMatchesNull(String s, boolean ignoreCase) {
    try {
      return "" + s.regionMatches(ignoreCase, -1, null, 0, 1);
    } catch (NullPointerException e) {
      return "NullPointerException";
    }
  }
  static String valueOf(int o, int c) {
    char[] data = {'a', 'b', 'c'};
    try {
      return String.valueOf(data, o, c);
    } catch (RuntimeException e) {
      return fail(e);
    }
  }
  // without a version the messages need not be those of Java 8
  public static void notJava8() {
    assert substring("abc", 2, 1).equals(
      "StringIndexOutOfBoundsException: String index out of range: -1");
  }
  // GENERATED
}
