#!/bin/bash
#
# Lifecycle wrapper for the CBMC TypeScript parse server.
# Usage: cbmc_ts_server {start|stop|status|socket-path}
#
# - `start`:    launches node with ts_ast_server.js, waits for READY,
#               prints the socket path on stdout.
# - `stop`:     sends SIGTERM to the server PID from the PID file.
# - `status`:   prints running/stopped + the socket path.
# - `socket-path`: prints the socket path without starting.
#
# When the server is running, downstream CBMC invocations should set
# CBMC_TS_SERVER_SOCKET=<path> (the `start` subcommand's stdout is the
# path; useful for `eval` patterns).
#
# Managed by build system fixtures (e.g. CMake FIXTURES_SETUP /
# FIXTURES_CLEANUP for the TypeScript regression suite).

set -eu

# Locate the ts_ast_server.js alongside this script's source tree.
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
SERVER_JS="$SCRIPT_DIR/../src/typescript/ts_ast_server.js"

# Runtime directory for sockets and PID files.
RUN_DIR="${XDG_RUNTIME_DIR:-/tmp}"
USER_ID="${USER:-$(id -un)}"
SOCKET_PATH="$RUN_DIR/cbmc-ts-$USER_ID.sock"
PID_FILE="$RUN_DIR/cbmc-ts-$USER_ID.pid"
LOG_FILE="$RUN_DIR/cbmc-ts-$USER_ID.log"

cmd="${1:-}"

case "$cmd" in
  start)
    if [ -f "$PID_FILE" ]; then
      old_pid=$(cat "$PID_FILE" 2>/dev/null || echo "")
      if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
        echo "$SOCKET_PATH"
        exit 0
      fi
      rm -f "$PID_FILE"
    fi
    if [ ! -f "$SERVER_JS" ]; then
      echo "error: server script not found at $SERVER_JS" >&2
      exit 2
    fi
    rm -f "$SOCKET_PATH"
    # Start the server in the background, redirecting stdout/stderr
    # to the log file.
    nohup node "$SERVER_JS" "$SOCKET_PATH" >"$LOG_FILE" 2>&1 &
    server_pid=$!
    echo "$server_pid" >"$PID_FILE"
    # Wait up to 10 seconds for the READY marker.
    for _ in $(seq 1 100); do
      if grep -q "^READY" "$LOG_FILE" 2>/dev/null; then
        break
      fi
      sleep 0.1
    done
    if ! grep -q "^READY" "$LOG_FILE" 2>/dev/null; then
      echo "error: server did not become ready within 10s" >&2
      echo "--- server log ---" >&2
      cat "$LOG_FILE" >&2 || true
      kill -TERM "$server_pid" 2>/dev/null || true
      rm -f "$PID_FILE"
      exit 3
    fi
    echo "$SOCKET_PATH"
    ;;
  stop)
    if [ ! -f "$PID_FILE" ]; then
      exit 0
    fi
    pid=$(cat "$PID_FILE" 2>/dev/null || echo "")
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      kill -TERM "$pid" 2>/dev/null || true
      # Wait up to 5 seconds for exit.
      for _ in $(seq 1 50); do
        if ! kill -0 "$pid" 2>/dev/null; then
          break
        fi
        sleep 0.1
      done
      # Force-kill if still alive.
      if kill -0 "$pid" 2>/dev/null; then
        kill -KILL "$pid" 2>/dev/null || true
      fi
    fi
    rm -f "$PID_FILE" "$SOCKET_PATH"
    ;;
  status)
    if [ -f "$PID_FILE" ]; then
      pid=$(cat "$PID_FILE" 2>/dev/null || echo "")
      if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        echo "running (pid=$pid) socket=$SOCKET_PATH"
        exit 0
      fi
    fi
    echo "stopped"
    exit 1
    ;;
  socket-path)
    echo "$SOCKET_PATH"
    ;;
  *)
    echo "usage: $0 {start|stop|status|socket-path}" >&2
    exit 1
    ;;
esac
