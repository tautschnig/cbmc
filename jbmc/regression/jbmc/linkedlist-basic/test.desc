CORE
LinkedListBasic
--function LinkedListBasic.testBasicOps --unwind 6 -cp target/classes:../../../lib/java-models-library/target/core-models.jar:../../../lib/java-models-library/target/cprover-api.jar
^EXIT=0$
^SIGNAL=0$
^VERIFICATION SUCCESSFUL$
