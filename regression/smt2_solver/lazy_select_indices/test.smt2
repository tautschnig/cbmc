(set-logic QF_ABV)
(declare-fun a1 () (Array (_ BitVec 32) (_ BitVec 8)))
(declare-fun src () (_ BitVec 32))
(declare-fun dst () (_ BitVec 32))
(assert (let ((?v2 (store a1 dst (select a1 src))))
  (let ((?v4 (store ?v2 (bvadd dst (_ bv1 32)) (select ?v2 (bvadd src (_ bv1 32))))))
    (let ((?v6 (store ?v4 (bvadd dst (_ bv2 32)) (select ?v4 (bvadd src (_ bv2 32))))))
      (not (= (select a1 (bvadd src (_ bv0 32)))
              (select ?v6 (bvadd dst (_ bv0 32)))))))))
(assert (not (bvult (bvadd dst (_ bv3 32)) dst)))
(assert (not (bvult (bvadd src (_ bv3 32)) src)))
(assert (not (and (bvult src (bvadd dst (_ bv3 32))) (bvult dst (bvadd src (_ bv3 32))))))
(check-sat)
(exit)
