(set-logic QF_AX)
(declare-sort I 0)
(declare-sort E 0)
(declare-fun a1 () (Array I E))
(declare-fun a2 () (Array I E))
(declare-fun i1 () I)
(declare-fun i2 () I)
(assert (let ((?v_0 (store a2 i1 (select a1 i1))) (?v_1 (store a1 i1 (select a2 i1)))) (= (store ?v_1 i2 (select ?v_0 i2)) (store ?v_0 i2 (select ?v_1 i2)))))
(assert (not (= a1 a2)))
(check-sat)
(exit)
