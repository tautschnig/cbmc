(set-logic QF_ABV)
(declare-fun a () (Array (_ BitVec 32) (_ BitVec 8)))
(declare-fun x () (_ BitVec 32))
(declare-fun y () (_ BitVec 8))
(assert (let ((?a1 (store a x y)))
  (let ((?a2 (store ?a1 (bvadd x (_ bv1 32)) (bvxor y (_ bv255 8)))))
    (let ((?a3 (store ?a2 (bvadd x (_ bv2 32)) y)))
      (let ((?a4 (store ?a3 (bvadd x (_ bv3 32)) (bvxor y (_ bv255 8)))))
        (not (= (select ?a4 x) y)))))))
(check-sat)
(exit)
