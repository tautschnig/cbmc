(set-logic QF_AX)
(declare-sort I 0)
(declare-sort E 0)
(declare-fun a () (Array I E))
(declare-fun i () I)
(declare-fun j () I)
(assert
  (let ((?v1 (select a i)) (?v2 (select a j)))
    (let ((?s1 (store (store a i ?v2) j ?v1))
          (?s2 (store (store a j ?v1) i ?v2)))
      (not (= (store (store ?s1 j (select ?s1 i)) i (select ?s1 j))
              (store (store ?s2 i (select ?s2 j)) j (select ?s2 i)))))))
(check-sat)
(exit)
