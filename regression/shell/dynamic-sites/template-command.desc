CORE
template-command.sh
--resolve-dynamic-sites --show-dynamic-sites
^EXIT=0$
^SIGNAL=0$
^shell-eval:template-command.sh:5:1: .*: \{ \*"/msg hello" \}$
^shell-command-name:template-command.sh#eval-5-1:1:1: .*: \{ \*"/msg" \}$
