main.sh
--show-parse-tree
^EXIT=0$
^SIGNAL=0$
^    word q"single \$x"$
^    word dq\(lit"double " param\(x\) lit" " param\(y\)\)$
^    word param\(1\)$
^    word param\(#\)$
^    word param\(\?\)$
^      cmdsubst#1:$
^          word lit"date"$
^      cmdsubst#2:$
^          word lit"uname"$
